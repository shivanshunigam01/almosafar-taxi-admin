# =============================================================================
# Almosafar Taxi — environment template
# Copy per app: apps/passenger/.env, apps/driver/.env, apps/admin/.env.local
# Never commit real secrets or service account JSON.
# =============================================================================

# --- Demo banners ---
ALMOSAFAR_DEMO_MODE=true
NEXT_PUBLIC_ALMOSAFAR_DEMO_MODE=true
NODE_ENV=development

# --- Currency (ISO 4217) ---
ALMOSAFAR_DEFAULT_CURRENCY=IQD

# --- Firebase (Expo passenger + driver) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Firebase (Next.js admin) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Maps (optional) ---
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Admin UI ---
NEXT_PUBLIC_APP_NAME=Almosafar Taxi Admin

# --- Firebase seed CLI ONLY (machine running Admin SDK — NOT in mobile/admin apps) ---
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# FIREBASE_PROJECT_ID=your-project-id
# DEMO_SEED_PASSWORD=min-12-chars-set-locally
# DEMO_ADMIN_EMAIL=demo.admin@almosafar.example.com

# --- EAS ---
# EAS_PROJECT_ID_PASSENGER=
# EAS_PROJECT_ID_DRIVER=
