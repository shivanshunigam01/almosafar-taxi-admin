{
  "name": "@almosafar/ui",
  "version": "0.1.0",
  "private": true,
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "description": "Shared web UI primitives for Almosafar Taxi admin",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "react": "19.3.0",
    "typescript": "^5.7.3"
  }
}
