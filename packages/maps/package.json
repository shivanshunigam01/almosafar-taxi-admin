{
  "name": "@almosafar/maps",
  "version": "0.1.0",
  "private": true,
  "description": "Leaflet map services and React components for Almosafar Taxi web apps",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@almosafar/shared": "*",
    "leaflet": "^1.9.4",
    "react-leaflet": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.16",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
